# ==============================================================================
# SK VISA EXPERTS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in the required credentials.
# NEVER commit .env or secret keys into source control!
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="SK Visa Experts"
NEXT_PUBLIC_PHONE="+966 59 932 6936"
NEXT_PUBLIC_WHATSAPP="966599326936"

# ------------------------------------------------------------------------------
# 1. EMAIL & FORM DISPATCH (Enquiry & Contact Form)
# ------------------------------------------------------------------------------
# Web3Forms API Key (get your free key from https://web3forms.com)
WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Choose Resend or SMTP (Nodemailer). If empty, the app logs submissions to console.
RESEND_API_KEY=
EMAIL_FROM="SK Visa Experts <enquiries@skvisaexperts.com>"
EMAIL_TO="info@skvisaexperts.com"

# SMTP fallback (e.g. Gmail, SendGrid, Amazon SES, or custom SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password_here

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAYS (Server-side Only)
# ------------------------------------------------------------------------------

# Gateway 1: Stripe (Global Cards, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_here

# Gateway 2: PayPal (Global & Regional)
PAYPAL_CLIENT_ID=paypal_client_id_placeholder
PAYPAL_CLIENT_SECRET=paypal_secret_placeholder
PAYPAL_ENVIRONMENT=sandbox # or 'live'

# Gateway 3: JazzCash (Pakistan / Regional)
JAZZCASH_MERCHANT_ID=jazzcash_merchant_placeholder
JAZZCASH_PASSWORD=jazzcash_password_placeholder
JAZZCASH_INTEGRITY_SALT=jazzcash_salt_placeholder
JAZZCASH_RETURN_URL=http://localhost:3000/api/payments/jazzcash/callback

# Gateway 4: Easypaisa (Pakistan / Regional)
EASYPAISA_STORE_ID=easypaisa_store_placeholder
EASYPAISA_HASH_KEY=easypaisa_hash_placeholder
EASYPAISA_POST_BACK_URL=http://localhost:3000/api/payments/easypaisa/callback

# Gateway 5: Direct Bank Transfer (Saudi / Wire / IBAN)
# IBAN details and manual verification workflow instructions
BANK_NAME="Al Rajhi Bank / Saudi National Bank"
BANK_ACCOUNT_NAME="SK Visa Experts Co."
BANK_IBAN="SA0000000000000000000000"
BANK_SWIFT="RJHIXXXX"

# Gateway 6: Tap Payments (GCC, Mada, KNET, Benefit, Visa/MC)
TAP_SECRET_KEY=sk_test_tap_placeholder
NEXT_PUBLIC_TAP_PUBLISHABLE_KEY=pk_test_tap_placeholder

# Gateway 7: Telr (Middle East / Africa Payments)
TELR_STORE_ID=telr_store_placeholder
TELR_AUTH_KEY=telr_auth_placeholder
TELR_TEST_MODE=1 # 1 for test, 0 for live

# Gateway 8: PayTabs (Saudi Arabia, Mada, Visa/MC, OmanNet, Amex)
PAYTABS_PROFILE_ID=paytabs_profile_placeholder
PAYTABS_SERVER_KEY=paytabs_server_key_placeholder
PAYTABS_REGION=SAU # SAU, ARE, EGY, GLOBAL
